# apply-kit settings. Copy to .env (gitignored) and fill in values. Never commit real values.

# Local service
PORT=
# Optional: override the database location (default: ~/Library/Application Support/apply-kit/apply-kit.db)
APPLY_KIT_DB_PATH=
# Sources to check until the Sources screen exists: comma-separated kind:value, e.g. greenhouse:payhawkio,email:linkedin
APPLY_KIT_SOURCES=
# When Sources are checked, in local time. Defaults: every 30 minutes, 07:00-23:00
APPLY_KIT_CHECK_EVERY_MINUTES=
APPLY_KIT_CHECK_WINDOW=

# AI (OpenRouter, DeepSeek with providers pinned to non-China hosts)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_MONTHLY_CAP_USD=

# Dedicated Gmail job mailbox, read over IMAP (read-only) with an app password (README › Job mailbox).
# Alert sources are listed in APPLY_KIT_SOURCES, e.g. email:linkedin,email:jobsbg,email:google,email:workday,email:mygreenhouse
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: the one folder read (a Gmail label); default INBOX
GMAIL_MAILBOX=

# Job APIs that need a key
JOOBLE_API_KEY=
REED_API_KEY=

# Nightly backup copy of the database (a folder you pick, e.g. in iCloud Drive)
BACKUP_DIR=
