# apply-kit settings. Copy to .env (gitignored) and fill in values. Never commit real values.

# Local service
PORT=
# Optional: override the database location (default: ~/Library/Application Support/apply-kit/apply-kit.db)
APPLY_KIT_DB_PATH=

# AI (OpenRouter, DeepSeek with providers pinned to non-China hosts)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_MONTHLY_CAP_USD=

# Dedicated Gmail job mailbox, read over IMAP with an app password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Job APIs that need a key
JOOBLE_API_KEY=
REED_API_KEY=

# Nightly backup copy of the database (a folder you pick, e.g. in iCloud Drive)
BACKUP_DIR=
