{
  "name": "@apply-kit/app",
  "private": true,
  "type": "module",
  "description": "Local service (Hono API + scheduler host) and the React + Vite UI in ui/.",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c green,magenta \"tsx watch --clear-screen=false src/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/main.ts",
    "eval:extraction": "tsx src/evaluation/main.ts"
  },
  "dependencies": {
    "@apply-kit/core": "workspace:*",
    "@fontsource/geologica": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@hono/node-server": "^2.1.4",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.116",
    "hono": "^4.13.13",
    "imapflow": "2.0.7",
    "mailparser": "3.9.28",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.62.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
