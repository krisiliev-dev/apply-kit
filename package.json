{
  "name": "apply-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup:data": "node scripts/setup.mjs",
    "dev": "pnpm --filter @apply-kit/app dev",
    "start": "pnpm --filter @apply-kit/app start",
    "service:install": "sh scripts/launchagent.sh install",
    "service:uninstall": "sh scripts/launchagent.sh uninstall",
    "service:status": "sh scripts/launchagent.sh status",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "eval:extraction": "pnpm --filter @apply-kit/app eval:extraction"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
