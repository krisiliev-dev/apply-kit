#!/usr/bin/env bash
# Thin wrapper for the most common CV-maker commands.
# Portable bash — works on macOS + Linux. No Node, no deps.

set -euo pipefail

PORT="${CV_MAKER_PORT:-3000}"

# Walk up from this script to find the repo root (contains package.json).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<EOF
cv — CV-maker helper

Commands:
  cv start    Kill any stale dev server on port $PORT, then run npm run dev
  cv open     Open http://localhost:$PORT in the default browser
  cv backup   Print instructions for backing up (browser state isn't reachable from Node)
  cv help     Show this message

Env:
  CV_MAKER_PORT    Override port (default: 3000)
EOF
}

kill_stale() {
  # Prefer lsof (macOS, most Linuxes). Fall back to fuser if missing.
  if command -v lsof >/dev/null 2>&1; then
    local pids
    pids="$(lsof -ti tcp:"$PORT" 2>/dev/null || true)"
    if [ -n "$pids" ]; then
      echo "Killing stale process(es) on :$PORT — $pids"
      # shellcheck disable=SC2086
      kill $pids 2>/dev/null || true
      sleep 1
      # shellcheck disable=SC2086
      kill -9 $pids 2>/dev/null || true
    fi
  elif command -v fuser >/dev/null 2>&1; then
    fuser -k "${PORT}/tcp" >/dev/null 2>&1 || true
  fi
}

cmd_start() {
  cd "$REPO_ROOT"
  kill_stale
  echo "Starting CV-maker on :$PORT …"
  exec npm run dev
}

cmd_open() {
  local url="http://localhost:$PORT"
  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  else
    echo "Can't detect how to open a browser. Visit: $url"
    exit 1
  fi
}

cmd_backup() {
  cat <<EOF
Backups live in your browser's localStorage, so they're not reachable from Node.

To back up now:
  1. Start the app:           cv start
  2. Open it:                 cv open
  3. Go to:                   http://localhost:$PORT/settings
  4. Switch to the Backup tab and click 'Download backup (.json)'.

To automate daily backups:
  - On Chromium (Chrome/Edge/Arc): Backup tab → 'Choose backup folder'.
    The app will write cv-maker-YYYY-MM-DD.json to that folder on a
    schedule you set. Safari/Firefox don't support this yet.
EOF
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    start) cmd_start ;;
    open) cmd_open ;;
    backup) cmd_backup ;;
    help|--help|-h) usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
