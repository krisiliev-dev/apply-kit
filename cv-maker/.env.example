# Copy this to .env.local and fill in.
# The key is only used server-side in app/api/chat/route.ts.
ANTHROPIC_API_KEY=

# Optional: Gmail email-alert ingestion (see docs/email-alerts.md).
# Reads LinkedIn/jobs.bg saved-search alert emails from your inbox over IMAP.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional Gmail label to read instead of the whole inbox (e.g. job-alerts).
GMAIL_MAILBOX=

# Optional: Jooble aggregator API key (free — jooble.org/api/about). Covers
# Bulgaria + 68 other countries; used by discovery sources of kind "jooble".
JOOBLE_API_KEY=

# Optional free job-API keys. Reed (UK incl. Manchester — reed.co.uk/developers)
# and Findwork (findwork.dev). Remotive/Jobicy/The Muse need no key.
REED_API_KEY=
FINDWORK_API_KEY=
