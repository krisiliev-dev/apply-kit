{
  "manifest_version": 3,
  "name": "CV-maker Capture",
  "version": "0.1.0",
  "description": "Capture job postings from your own logged-in sessions (LinkedIn, jobs.bg, Indeed, Glassdoor, any career page) into CV-maker's discovery pool. Reads only the pages you're already viewing — your session, no scraping.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://www.jobs.bg/*",
    "https://*.jobs.bg/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "CV-maker Capture" },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://www.jobs.bg/*",
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
