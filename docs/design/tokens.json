{
  "$description": "apply-kit design tokens, direction 'Vitosha' (W3C Design Tokens Community Group format). Light and dark modes live under color.light / color.dark with identical keys. Decided 2026-10-11.",
  "palette": {
    "$type": "color",
    "stone": {
      "50":  { "$value": "#f6f8f6" },
      "100": { "$value": "#edf1ee", "$description": "Stone mist: the app ground in light mode" },
      "200": { "$value": "#e1e8e3" },
      "300": { "$value": "#d5ddd8", "$description": "Lichen: hairline rules" },
      "500": { "$value": "#879690", "$description": "Control borders (3:1 on white)" },
      "700": { "$value": "#5a6962" },
      "800": { "$value": "#45554e" },
      "900": { "$value": "#1d2b25", "$description": "Pine ink: primary text" }
    },
    "pine": {
      "300": { "$value": "#93d4b9" },
      "400": { "$value": "#7cc4a8" },
      "600": { "$value": "#2c6652", "$description": "Pine: actions, met requirements" },
      "700": { "$value": "#24584a", "$description": "Pine deep: hover, CV accent" },
      "100": { "$value": "#e0eee7" }
    },
    "bloom": {
      "300": { "$value": "#e889aa" },
      "600": { "$value": "#a33d62", "$description": "Alpine pink: only 'needs you' and wins" },
      "100": { "$value": "#f7e3ea" }
    },
    "ochre": {
      "300": { "$value": "#ecd08e" },
      "700": { "$value": "#75561a", "$description": "Partly met, warnings" },
      "100": { "$value": "#f6ecd1" }
    },
    "rose": {
      "300": { "$value": "#efa3aa" },
      "700": { "$value": "#a33e46", "$description": "Gaps, errors, destructive" },
      "100": { "$value": "#f6e2e3" }
    },
    "night": {
      "950": { "$value": "#0e1513" },
      "900": { "$value": "#121a17", "$description": "Ground in dark mode" },
      "850": { "$value": "#19231f", "$description": "Surface in dark mode" },
      "800": { "$value": "#22302a" },
      "700": { "$value": "#2a3732", "$description": "Rules in dark mode" },
      "500": { "$value": "#61746b" },
      "300": { "$value": "#8fa199" },
      "200": { "$value": "#b8c6bf" },
      "100": { "$value": "#e5ece8" }
    }
  },
  "color": {
    "$type": "color",
    "light": {
      "ground":         { "$value": "{palette.stone.100}", "$description": "Page background" },
      "surface":        { "$value": "#ffffff", "$description": "Cards, tables, panels" },
      "surface-sunken": { "$value": "{palette.stone.200}", "$description": "Wells, hidden rows, inputs on surface" },
      "ink":            { "$value": "{palette.stone.900}", "$description": "Primary text (14.7:1 on surface)" },
      "ink-2":          { "$value": "{palette.stone.800}", "$description": "Secondary text (7.9:1)" },
      "ink-3":          { "$value": "{palette.stone.700}", "$description": "Meta text, why-lines (5.8:1 on surface, 5.1:1 on ground, 4.6:1 on sunken)" },
      "rule":           { "$value": "{palette.stone.300}", "$description": "Hairlines and dividers (decorative)" },
      "border-control": { "$value": "{palette.stone.500}", "$description": "Input and control borders (3:1)" },
      "action":         { "$value": "{palette.pine.600}", "$description": "Primary buttons, links, focus" },
      "action-hover":   { "$value": "{palette.pine.700}" },
      "on-action":      { "$value": "#ffffff" },
      "bloom":          { "$value": "{palette.bloom.600}", "$description": "Needs you, wins. Never decoration" },
      "bloom-soft":     { "$value": "{palette.bloom.100}" },
      "met":            { "$value": "{palette.pine.600}" },
      "met-soft":       { "$value": "{palette.pine.100}" },
      "partly":         { "$value": "{palette.ochre.700}" },
      "partly-soft":    { "$value": "{palette.ochre.100}" },
      "gap":            { "$value": "{palette.rose.700}" },
      "gap-soft":       { "$value": "{palette.rose.100}" },
      "focus":          { "$value": "{palette.pine.600}" }
    },
    "dark": {
      "ground":         { "$value": "{palette.night.900}" },
      "surface":        { "$value": "{palette.night.850}" },
      "surface-sunken": { "$value": "{palette.night.950}" },
      "ink":            { "$value": "{palette.night.100}" },
      "ink-2":          { "$value": "{palette.night.200}" },
      "ink-3":          { "$value": "{palette.night.300}" },
      "rule":           { "$value": "{palette.night.700}" },
      "border-control": { "$value": "{palette.night.500}" },
      "action":         { "$value": "{palette.pine.400}" },
      "action-hover":   { "$value": "{palette.pine.300}" },
      "on-action":      { "$value": "{palette.night.950}" },
      "bloom":          { "$value": "{palette.bloom.300}" },
      "bloom-soft":     { "$value": "#3a2230" },
      "met":            { "$value": "{palette.pine.300}" },
      "met-soft":       { "$value": "#1b3129" },
      "partly":         { "$value": "{palette.ochre.300}" },
      "partly-soft":    { "$value": "#362d16" },
      "gap":            { "$value": "{palette.rose.300}" },
      "gap-soft":       { "$value": "#3b2226" },
      "focus":          { "$value": "{palette.pine.400}" }
    },
    "document": {
      "$description": "CV and cover letter: always printed on white, independent of app theme",
      "paper":  { "$value": "#ffffff" },
      "text":   { "$value": "#1d2b25" },
      "muted":  { "$value": "#4e5c56" },
      "accent": { "$value": "{palette.pine.700}" },
      "rule":   { "$value": "#d5ddd8" }
    }
  },
  "document": {
    "$description": "A4 geometry and type for the CV and cover letter template, in print units. Mirrors the --doc-* dimensions in tokens.css",
    "page":    { "$type": "dimension", "width": { "$value": "210mm" }, "height": { "$value": "297mm" }, "margin": { "$value": "18mm" }, "photo": { "$value": "26mm", "$description": "Photo slot, top right, only when the package switches it on" } },
    "size":    { "$type": "dimension", "name": { "$value": "20pt" }, "section": { "$value": "10.5pt" }, "body": { "$value": "9.75pt" }, "small": { "$value": "8.75pt" } },
    "line-height": { "$type": "number", "body": { "$value": 1.38 } },
    "gap":     { "$type": "dimension", "section": { "$value": "4.5mm" }, "item": { "$value": "2.5mm" }, "line": { "$value": "0.8mm" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display":  { "$value": ["Geologica", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Headings, numbers, CV name and section titles. Full Cyrillic" },
      "text":     { "$value": ["Onest", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "All running text and UI. Full Cyrillic" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Ratio 1.25 from a 15px body",
      "caption": { "$value": "12px" },
      "small":   { "$value": "13px" },
      "body":    { "$value": "15px" },
      "title":   { "$value": "18px" },
      "h3":      { "$value": "22px" },
      "h2":      { "$value": "28px" },
      "h1":      { "$value": "35px" },
      "display": { "$value": "44px" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 }, "snug": { "$value": 1.3 }, "body": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.02em" }, "none": { "$value": "0em" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base",
    "0": { "$value": "0px" }, "1": { "$value": "2px" }, "2": { "$value": "4px" }, "3": { "$value": "8px" },
    "4": { "$value": "12px" }, "5": { "$value": "16px" }, "6": { "$value": "20px" }, "7": { "$value": "24px" },
    "8": { "$value": "32px" }, "9": { "$value": "40px" }, "10": { "$value": "56px" }
  },
  "size": {
    "$type": "dimension",
    "$description": "Icons, controls and layout widths (Profile, Setup and Package screens)",
    "icon-xs": { "$value": "11px", "$description": "Icon inside a chip" },
    "icon-s": { "$value": "14px", "$description": "Icon beside small text" },
    "h-control": { "$value": "40px", "$description": "Minimum height of an input-like control" },
    "h-textarea": { "$value": "88px", "$description": "Minimum height of a multi-line text box" },
    "w-chip-input-min": { "$value": "80px" }, "w-chip-input": { "$value": "120px", "$description": "Typing field inside a chips editor" },
    "w-tile-min": { "$value": "160px", "$description": "Narrowest tally tile" },
    "w-field-min": { "$value": "200px", "$description": "Narrowest growing field or text in a row" },
    "w-search-min": { "$value": "220px" }, "w-search": { "$value": "320px", "$description": "Search box in a toolbar" },
    "w-side-min": { "$value": "260px" }, "w-side": { "$value": "320px", "$description": "Side column beside a form" },
    "w-card-min": { "$value": "280px", "$description": "Narrowest card in a grid" },
    "w-form": { "$value": "640px", "$description": "Widest form or dialog of a form" }
  },
  "radius": {
    "$type": "dimension",
    "sheet":   { "$value": "3px", "$description": "A4 documents: paper has sharp-ish corners" },
    "small":   { "$value": "6px", "$description": "Swatches, inline wells" },
    "control": { "$value": "10px", "$description": "Inputs, selects, table containers" },
    "card":    { "$value": "14px", "$description": "Panels and surfaces" },
    "pill":    { "$value": "999px", "$description": "Buttons, chips, status badges" }
  },
  "shadow": {
    "$type": "shadow",
    "raised":  { "$value": [{ "color": "#1d2b250f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, { "color": "#1d2b250d", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px" }], "$description": "Surfaces on the ground (light mode only; dark mode uses rules)" },
    "overlay": { "$value": [{ "color": "#1d2b2524", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-6px" }], "$description": "Menus, dialogs, toasts" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }, "exit": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
